# Pasta de referências (documentos internos — NÃO publicar)
docs/refs/

# Configuração pessoal do usuário (gerada a partir de config.example.toml)
config.toml

# Segredos / ambiente
.env
.env.*
*.pem
*.key
secrets.json
# Exceção: os TEMPLATES .env.example dos perfis são versionados (só placeholders).
!.env.example
!**/.env.example

# Volumosos / gerados
.venv/
node_modules/
__pycache__/

# Cache repo-local de skills (venvs, modelos baixados etc.) — ADR 0011
.cache/

# Registro bruto de experimento: volumoso, e um caso futuro pode vir de material não público.
# Versiona-se o resumo no README do experimento (docs/experimentos/README.md).
/docs/experimentos/*/execucoes/

# Worktrees do agente: o nome escolhido pode citar projeto confidencial, e versionar a pasta
# levaria uma cópia inteira da árvore para dentro dela mesma (MT-40). Ancorado na raiz, porque
# `.claude/` solto casaria em qualquer nível e engoliria os `profiles/*/.claude/` versionados,
# que são os templates distribuídos. Só os worktrees e o override local — `/.claude/settings.json`
# segue versionável, para o framework poder se aplicar a si mesmo.
/.claude/worktrees/
/.claude/settings.local.json
